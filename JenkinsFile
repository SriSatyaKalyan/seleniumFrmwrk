pipeline {
    agent any

    tools {
        // Use the JDK installed on Jenkins (adjust the name as per your Jenkins config)
        jdk 'openjdk-11'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean install -DskipTests'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Publish Reports') {
            steps {
                junit '**/target/surefire-reports/*.xml'
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: false,
                    keepAll: true,
                    reportDir: 'target/cucumber-reports',
                    reportFiles: 'cucumber-html-reports/overview-features.html',
                    reportName: 'Cucumber Report'
                ])
            }
        }

        stage('Send Metrics to InfluxDB') {
            steps {
                script {
                    def testResults = readTestResults('test-results/results.xml')

                    step([
                        $class: 'InfluxDbPublisher',
                        selectedTarget: 'Jenkins Metrics',
                        customDataMap: [
                            'test_total': testResults.totalCount,
                            'test_failed': testResults.failCount,
                            'test_passed': testResults.passCount,
                            'test_skipped': testResults.skipCount,
                            'build_duration': currentBuild.duration,
                            'build_result': currentBuild.result ?: 'SUCCESS'
                        ]
                    ])
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'target/**/*.jar', allowEmptyArchive: true
            cleanWs()
        }
        success {
            echo 'Tests passed successfully!'
        }
        failure {
            echo 'Tests failed!'
        }
        unstable {
            echo 'Some tests failed!'
        }
    }
}
