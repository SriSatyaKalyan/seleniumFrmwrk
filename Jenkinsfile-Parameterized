pipeline {
    agent any

    parameters {
        choice(
            name: 'TEST_SUITE',
            choices: ['smoke', 'regression', 'functional', 'all'],
            description: 'Select the test suite to run'
        )
        choice(
            name: 'BROWSER_MODE',
            choices: ['chrome', 'headless'],
            description: 'Select browser execution mode'
        )
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'staging', 'prod'],
            description: 'Select target environment'
        )
        booleanParam(
            name: 'PARALLEL_EXECUTION',
            defaultValue: false,
            description: 'Enable parallel test execution'
        )
        string(
            name: 'CUSTOM_TAGS',
            defaultValue: '',
            description: 'Custom Cucumber tags (optional, overrides TEST_SUITE)'
        )
    }

    environment {
        MAVEN_OPTS = '-Dmaven.repo.local=.m2/repository'
        TESTNG_CONFIG = getTestNGConfig("${params.TEST_SUITE}", "${params.BROWSER_MODE}")
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Running ${params.TEST_SUITE} tests in ${params.BROWSER_MODE} mode"
            }
        }

        stage('Setup') {
            steps {
                script {
                    // Ensure reports directory exists
                    sh 'mkdir -p target/cucumber-reports'
                    sh 'mkdir -p target/screenshots'
                }
            }
        }

        stage('Execute Tests') {
            steps {
                script {
                    def mavenCommand = buildMavenCommand()
                    echo "Executing: ${mavenCommand}"

                    sh "${mavenCommand}"
                }
            }
        }

        stage('Generate Reports') {
            steps {
                script {
                    // Publish TestNG results
                    publishTestResults testResultsPattern: 'target/surefire-reports/testng-results.xml'

                    // Publish Cucumber reports
                    publishHTML([
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'target/cucumber-reports',
                        reportFiles: '*.html',
                        reportName: "Cucumber Report - ${params.TEST_SUITE}",
                        reportTitles: ''
                    ])
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'target/cucumber-reports/**/*', fingerprint: true
                archiveArtifacts artifacts: 'target/screenshots/**/*', fingerprint: true, allowEmptyArchive: true
            }
        }

        stage('Notifications') {
            steps {
                script {
                    def testResults = readTestResults()
                    def message = """
                        Test Suite: ${params.TEST_SUITE}
                        Browser Mode: ${params.BROWSER_MODE}
                        Environment: ${params.ENVIRONMENT}

                        Results:
                        - Total Tests: ${testResults.total}
                        - Passed: ${testResults.passed}
                        - Failed: ${testResults.failed}
                        - Skipped: ${testResults.skipped}

                        Build: ${env.BUILD_URL}
                    """.stripIndent()

                    if (testResults.failed > 0) {
                        currentBuild.result = 'UNSTABLE'
                        // Send failure notification (configure your notification method)
                        echo "Tests failed: ${message}"
                    } else {
                        echo "All tests passed: ${message}"
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        failure {
            script {
                echo "Pipeline failed for ${params.TEST_SUITE} tests"
                // Add your failure notification logic here
            }
        }
        success {
            script {
                echo "Pipeline succeeded for ${params.TEST_SUITE} tests"
                // Add your success notification logic here
            }
        }
    }
}

def getTestNGConfig(testSuite, browserMode) {
    return "testng-${testSuite}-${browserMode}.xml"
}

def buildMavenCommand() {
    def command = "mvn clean test"

    // Add TestNG configuration
    command += " -DsuiteXmlFile=${env.TESTNG_CONFIG}"

    // Add browser parameter
    command += " -Dbrowser=${params.BROWSER_MODE}"

    // Add environment parameter
    command += " -Denvironment=${params.ENVIRONMENT}"

    // Add custom tags if provided
    if (params.CUSTOM_TAGS?.trim()) {
        command += " -Dcucumber.filter.tags=\"${params.CUSTOM_TAGS}\""
    }

    // Add parallel execution if enabled
    if (params.PARALLEL_EXECUTION) {
        command += " -DparallelMode=methods -DthreadCount=3"
    }

    // Add reporting options
    command += " -Dcucumber.plugin=pretty,html:target/cucumber-reports,json:target/cucumber-reports/cucumber.json,junit:target/cucumber-reports/cucumber.xml"

    return command
}

def readTestResults() {
    // Read TestNG results and return summary
    try {
        def testngResults = readFile('target/surefire-reports/testng-results.xml')
        // Parse XML and extract test counts
        // This is a simplified example - implement actual XML parsing
        return [
            total: 10,    // Replace with actual parsing
            passed: 8,   // Replace with actual parsing
            failed: 2,   // Replace with actual parsing
            skipped: 0   // Replace with actual parsing
        ]
    } catch (Exception e) {
        echo "Could not read test results: ${e.message}"
        return [total: 0, passed: 0, failed: 0, skipped: 0]
    }
}